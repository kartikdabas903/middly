# =============================================================================
# Middly — environment configuration (DEMO)
# Copy to .env (or run ./scripts/init-env.sh to generate random secrets).
# Never commit .env to Git.
# =============================================================================

COMPOSE_PROJECT_NAME=middly
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=INFO

# ---- Host ports -------------------------------------------------------------
FRONTEND_PORT=3000
GATEWAY_PORT=8000
KEYCLOAK_PORT=8080
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
RABBITMQ_MGMT_PORT=15672

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=middly
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=middly

# ---- Redis ------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis

# ---- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=middly
RABBITMQ_PASSWORD=change-me-rabbitmq

# ---- Keycloak (Identity Provider) ------------------------------------------
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# URL the *browser* uses to reach Keycloak. Tokens are issued with this issuer.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=middly
OIDC_CLIENT_ID=middly-frontend
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
OIDC_AUDIENCE=middly-api

# Demo user passwords imported into the Keycloak realm (DEMO ONLY)
DEMO_CITIZEN_PASSWORD=Citizen@123
DEMO_OFFICER_PASSWORD=Officer@123
DEMO_DEPTADMIN_PASSWORD=DeptAdmin@123
DEMO_ADMIN_PASSWORD=Admin@123

# ---- Frontend ---------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# 32+ random characters; encrypts the session cookies.
SESSION_SECRET=change-me-session-secret-at-least-32-chars

# ---- Mock department system credentials (used by connectors) ---------------
IDENTITY_CLIENT_ID=middly-platform
IDENTITY_CLIENT_SECRET=change-me-identity-secret
EDUCATION_API_KEY=change-me-education-key
EMPLOYMENT_BASIC_USER=middly
EMPLOYMENT_BASIC_PASSWORD=change-me-employment-password
SKILL_API_KEY=change-me-skill-key
GRIEVANCE_CLIENT_ID=middly-platform
GRIEVANCE_CLIENT_SECRET=change-me-grievance-secret
# Admin key used by the platform to inject faults / reset demo mocks
MOCK_ADMIN_KEY=change-me-mock-admin-key

# ---- Grafana ----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

