{
  "realm": "middly",
  "displayName": "Middly",
  "displayNameHtml": "Middly",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "permanentLockout": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(8)",
  "roles": {
    "realm": [
      {"name": "CITIZEN", "description": "Citizen applying for services and managing consent"},
      {"name": "OFFICER", "description": "Department officer reviewing applications"},
      {"name": "DEPARTMENT_ADMIN", "description": "Department administrator"},
      {"name": "PLATFORM_ADMIN", "description": "Interoperability platform administrator"}
    ]
  },
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"Username\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"Email\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"First name\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"Last name\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"citizen_id\",\"displayName\":\"Citizen ID\",\"validations\":{\"length\":{\"max\":20}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"department\",\"displayName\":\"Department code\",\"validations\":{\"length\":{\"max\":40}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ADMIN_EDIT\"}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "middly-frontend",
      "name": "Middly Portal (BFF)",
      "description": "Next.js backend-for-frontend. Confidential client, authorization code + PKCE.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["${FRONTEND_URL}/auth/callback"],
      "webOrigins": ["${FRONTEND_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${FRONTEND_URL}/*"
      },
      "protocolMappers": [
        {"name": "api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false,
         "config": {"included.custom.audience": "middly-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true"}},
        {"name": "citizen_id", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false,
         "config": {"user.attribute": "citizen_id", "claim.name": "citizen_id", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"}},
        {"name": "department", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false,
         "config": {"user.attribute": "department", "claim.name": "department", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true", "introspection.token.claim": "true"}}
      ]
    },
    {
      "clientId": "middly-demo-cli",
      "name": "Middly API explorer (DEMO only)",
      "description": "Public client with direct grants for Swagger/curl exploration in demo environments. Disable in production.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {"name": "api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false,
         "config": {"included.custom.audience": "middly-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true"}},
        {"name": "citizen_id", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false,
         "config": {"user.attribute": "citizen_id", "claim.name": "citizen_id", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}},
        {"name": "department", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper", "consentRequired": false,
         "config": {"user.attribute": "department", "claim.name": "department", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}}
      ]
    }
  ],
  "users": [
    {"id": "6f1c2a10-0000-4000-8000-000000100001", "username": "citizen1", "enabled": true, "emailVerified": true, "email": "citizen1@demo.middly.example",
     "firstName": "Rahul", "lastName": "Sharma", "attributes": {"citizen_id": ["100001"]}, "realmRoles": ["CITIZEN"],
     "credentials": [{"type": "password", "value": "${DEMO_CITIZEN_PASSWORD}", "temporary": false}]},
    {"id": "6f1c2a10-0000-4000-8000-000000100002", "username": "citizen2", "enabled": true, "emailVerified": true, "email": "citizen2@demo.middly.example",
     "firstName": "Priya", "lastName": "Deshmukh", "attributes": {"citizen_id": ["100002"]}, "realmRoles": ["CITIZEN"],
     "credentials": [{"type": "password", "value": "${DEMO_CITIZEN_PASSWORD}", "temporary": false}]},
    {"id": "6f1c2a10-0000-4000-8000-000000100003", "username": "citizen3", "enabled": true, "emailVerified": true, "email": "citizen3@demo.middly.example",
     "firstName": "Amit", "lastName": "Verma", "attributes": {"citizen_id": ["100003"]}, "realmRoles": ["CITIZEN"],
     "credentials": [{"type": "password", "value": "${DEMO_CITIZEN_PASSWORD}", "temporary": false}]},
