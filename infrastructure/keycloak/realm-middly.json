    {"id": "6f1c2a10-0000-4000-8000-0000000b0001", "username": "deptadmin1", "enabled": true, "emailVerified": true, "email": "deptadmin1@demo.middly.example",
     "firstName": "Meera", "lastName": "Iyer", "attributes": {"department": ["SKILL_DEV"]}, "realmRoles": ["DEPARTMENT_ADMIN", "OFFICER"],
     "credentials": [{"type": "password", "value": "${DEMO_DEPTADMIN_PASSWORD}", "temporary": false}]},
    {"id": "6f1c2a10-0000-4000-8000-0000000c0001", "username": "admin1", "enabled": true, "emailVerified": true, "email": "admin1@demo.middly.example",
     "firstName": "Platform", "lastName": "Administrator", "attributes": {}, "realmRoles": ["PLATFORM_ADMIN"],
     "credentials": [{"type": "password", "value": "${DEMO_ADMIN_PASSWORD}", "temporary": false}]}
  ]
}
