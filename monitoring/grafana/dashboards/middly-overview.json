  {
   "id": 101,
   "type": "row",
   "title": "Connectors (department systems)",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 7,
   "title": "Connector health",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (connector) (middly_connector_up)",
     "legendFormat": "{{connector}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "HEALTHY",
         "color": "green"
        },
        "0.5": {
         "text": "DEGRADED",
         "color": "orange"
        },
        "0": {
         "text": "DOWN",
         "color": "red"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "textMode": "value_and_name",
    "graphMode": "none"
   },
   "description": "1 = HEALTHY, 0.5 = DEGRADED, 0 = DOWN (live health checks)"
  },
  {
   "id": 8,
   "title": "Connector calls: success vs failure",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (connector) (rate(middly_connector_success_count_total[5m]))",
     "legendFormat": "{{connector}} ok",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (connector, reason) (rate(middly_connector_failure_count_total[5m]))",
     "legendFormat": "{{connector}} fail ({{reason}})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "options": {}
